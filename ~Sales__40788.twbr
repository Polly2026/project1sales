            <column caption='First Time Closed Won by Account' datatype='date' name='[Calculation_614178463385309184]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{fixed [Calculation_711568759570489345]: min (IF [Calculation_711568759572299783]=&quot;Y&quot; THEN [Calculation_822751375422500864]  END)}' />
              <desc>
