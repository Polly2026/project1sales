              <calculation class='tableau' formula='IF  [LinPack_523892480737294295]&lt;  50000 then &quot;20|&lt; 50k&quot;&#13;&#10;ELSEIF  [LinPack_523892480737294295]&lt; 100000 then &quot;30|50k - 100k&quot;&#13;&#10;ELSEIF  [LinPack_523892480737294295]&lt; 200000 then &quot;40|100k - 200k&quot;&#13;&#10;ELSEIF  [LinPack_523892480737294295]&lt; 500000 then &quot;50|200k - 500k&quot;&#13;&#10;ELSEIF  [LinPack_523892480737294295]&lt;1000000 then &quot;60|500k - 1M&quot;&#13;&#10;ELSE                                                  &quot;99|&gt;1M&quot;&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
