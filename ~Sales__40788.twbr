              <calculation class='tableau' formula='COUNTD(if STARTSWITH([Pipeline Review - DONE - Cat 1 (copy)_746190227238907913], &quot;Closed&quot;) and [Calculation_711568759572299783]&lt;&gt;&quot;Y&quot; then [Calculation_711568759570489345] end)' />
