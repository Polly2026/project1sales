            <column caption='Account' datatype='string' name='[Calculation_711568759570489345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Account Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Customer/Prospect</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Owner' datatype='string' name='[Calculation_711568759570620418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[First Name]+&apos; &apos;+[Last Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Owner of the opportunity</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Stage' datatype='string' name='[Calculation_711568759572115461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Stage]' />
