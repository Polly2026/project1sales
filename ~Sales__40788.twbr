              <calculation class='tableau' formula='if {fixed [Calculation_711568759570489345]: [LinPack_345685562057570044]}&gt;=1 then &quot;Existing Clients&quot; else &quot;Prospects&quot; end' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Days to Close' datatype='integer' default-format='n#,##0&quot; d&quot;;-#,##0&quot; d&quot;' name='[Calculation_680325065948213248]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;, [__MyToday], [Calculation_822751375422500864])' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Days to Close (bucket)' datatype='string' name='[Calculation_680325065948696577]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_680325065948213248]&lt;0 then &quot;Overdue&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;30 then &quot;0-30 days&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;90 then &quot;1-3 months&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;180 then &quot;3-6 months&quot;&#13;&#10;ELSE &quot;&gt; 6 months&quot;&#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Id' datatype='string' name='[Calculation_711568759570227200]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Opportunity ID]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Unique Identifier</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Account' datatype='string' name='[Calculation_711568759570489345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Account Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Customer/Prospect</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Owner' datatype='string' name='[Calculation_711568759570620418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[First Name]+&apos; &apos;+[Last Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Owner of the opportunity</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Description' datatype='string' name='[Calculation_711568759571951620]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Description</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Stage' datatype='string' name='[Calculation_711568759572115461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Stage]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Stage (according to your standards)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Open Flag' datatype='string' name='[Calculation_711568759572205574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Closed],&quot;N&quot;,&quot;Y&quot;,&quot;Unknown&quot;)' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Open</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Won Flag' datatype='string' name='[Calculation_711568759572299783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Closed] AND [Won],&quot;Y&quot;,&quot;N&quot;,&quot;Unknown&quot; )' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Closed and Won</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Probability %' datatype='real' default-format='p0%' name='[Calculation_711568759573139467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Probability (%)]/100' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Probability to win the opportunity (0.5 stands for 50%)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Close Date' datatype='date' datatype-customized='true' name='[Calculation_822751375422500864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Close Date]&#13;&#10;//DATE(DATEADD(&apos;month&apos;,5,[Close Date]))' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Actual Closed Date is the opportunity is Closed, else Estimated Close Date </run>
                  <run fontcolor='#333333' fontname='Tableau Regular' italic='true'>(Date used for time-series analysis)</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='date' hidden='true' name='[Close Date]' role='dimension' type='ordinal' />
            <column datatype='boolean' hidden='true' name='[Closed]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[Created Date]' role='dimension' type='ordinal' />
            <column caption='Days to Close (bucket) (sort)' datatype='integer' name='[Days to Close (bucket) (copy)_680325065952247810]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Calculation_680325065948213248]&lt;0 then 0&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;30 then 10&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;90 then 20&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;180 then 30&#13;&#10;ELSE 100&#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[First Name]' role='dimension' type='nominal' />
            <column caption='Is Won Opportunity?' datatype='boolean' name='[Is Open Opportunity? (copy)_17451502251433984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_711568759572299783]=&quot;Y&quot;' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Nb of Won Opportunities' datatype='integer' default-format='n#,##0;(#,##0)' name='[LinPack_345685562057570044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Is Open Opportunity? (copy)_17451502251433984] THEN [Calculation_711568759570227200] END)' />
              <desc>
                <formatted-text>
                  <run>Nb of Won Opportunities: &apos;Nb of Won Opportunities&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Avg Probability' datatype='real' default-format='p0%' name='[LinPack_494220919807321354]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([LinPack_574638457904073940])' />
              <desc>
                <formatted-text>
                  <run>Avg Probability: &apos;Avg Probability&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Weighted Pipeline Value' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_515310787283302498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(FLOAT(IF [Calculation_1142225515624624133] THEN [Calculation_711568759573139467]*[Amount] END))' />
              <desc>
                <formatted-text>
                  <run>Weighted Pipeline Value: &apos;Weighted Pipeline Value&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='_Avg Probability (Expression)' datatype='real' name='[LinPack_574638457904073940]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_711568759573139467]' />
              <desc>
                <formatted-text>
                  <run>_Avg Probability (Expression): &apos;Avg Probability&apos; expression (used in other KPI calculations, no aggregation rule)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Pipeline Value' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_802802616773774604]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(FLOAT(IF [Calculation_1142225515624624133] THEN [Amount] END))' />
              <desc>
                <formatted-text>
                  <run>Pipeline Value: &apos;Pipeline Value&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
