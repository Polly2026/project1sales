                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Label FOCUS - Closing Next x days  - Nb of Accounts (Prospect)' datatype='integer' name='[Label FOCUS - Closing Next x days  - Nb of Accounts (Client) (copy)_614178463397064722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Next&quot;) and [Calculation_614178463393964044]=&quot;Prospects&quot; then [Calculation_711568759570489345] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
