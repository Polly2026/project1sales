          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yaj0rm1ld7uq01glrp1l1po69cl'>
            <column datatype='string' hidden='true' name='[Account Name]' role='dimension' type='nominal' />
            <column datatype='real' default-format='C1033%' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Client/Prospect by Account' datatype='string' name='[Calculation_614178463393964044]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='if {fixed [Calculation_711568759570489345]: [LinPack_345685562057570044]}&gt;=1 then &quot;Existing Clients&quot; else &quot;Prospects&quot; end' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
