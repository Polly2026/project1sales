              <calculation class='tableau' formula='COUNTD(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Overdue&quot;) then [Calculation_711568759570489345] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
