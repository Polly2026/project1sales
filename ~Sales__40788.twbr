              </desc>
            </column>
            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Nb of Open Opportunities' datatype='integer' default-format='n#,##0;(#,##0)' name='[LinPack_260602485593130101]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Calculation_1142225515624624133] THEN [Calculation_711568759570227200] END)' />
              <desc>
                <formatted-text>
                  <run>Nb of Open Opportunities: &apos;Nb of Open Opportunities&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Weighted Pipeline Value' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_515310787283302498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(FLOAT(IF [Calculation_1142225515624624133] THEN [Calculation_711568759573139467]*[Amount] END))' />
              <desc>
                <formatted-text>
