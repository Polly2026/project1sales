              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='boolean' hidden='true' name='[Closed]' role='dimension' type='nominal' />
            <column datatype='datetime' name='[Created Date]' role='dimension' type='ordinal' />
            <column aggregation='Sum' caption='Days from Open' datatype='integer' default-format='n#,##0&quot; d&quot;;-#,##0&quot; d&quot;' name='[Days to Close (copy)_928304533158825988]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;, [Created Date], [__MyToday])' />
