    <worksheet name='Total Sales - Benchmark (for Selected Opp Owner)'>
      <table>
        <view>
          <datasources>
            <datasource caption='Opportunity' name='federated.0yaj0rm1ld7uq01glrp1l1po69cl' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Last N Months' datatype='integer' datatype-customized='true' folder-name='Sales Pipeline' name='[Last x Days (copy)_1142225515621146627]' param-domain-type='any' role='measure' type='quantitative' value='36'>
              <calculation class='tableau' formula='36' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='pSelectOpportunityOwner' datatype='string' folder-name='Sales Pipeline' name='[Opportunity Owner Parameter]' param-domain-type='list' role='measure' source-field='[federated.0yaj0rm1ld7uq01glrp1l1po69cl].[Calculation_711568759570620418]' type='nominal' value='&quot;Bellina Catmull&quot;'>
              <calculation class='tableau' formula='&quot;Bellina Catmull&quot;' />
            </column>
            <column caption='pPlaceholder' datatype='integer' folder-name='_Common' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='0'>
              <calculation class='tableau' formula='0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0yaj0rm1ld7uq01glrp1l1po69cl'>
            <column datatype='string' hidden='true' name='[Account Name]' role='dimension' type='nominal' />
            <column datatype='real' default-format='C1033%' name='[Amount]' role='measure' type='quantitative' />
            <column caption='Account' datatype='string' name='[Calculation_711568759570489345]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Account Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Customer/Prospect</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Owner' datatype='string' name='[Calculation_711568759570620418]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[First Name]+&apos; &apos;+[Last Name]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Owner of the opportunity</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Stage' datatype='string' name='[Calculation_711568759572115461]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Stage]' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Stage (according to your standards)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Won Flag' datatype='string' name='[Calculation_711568759572299783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Closed] AND [Won],&quot;Y&quot;,&quot;N&quot;,&quot;Unknown&quot; )' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Closed and Won</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Close Date' datatype='date' datatype-customized='true' name='[Calculation_822751375422500864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Close Date]&#13;&#10;//DATE(DATEADD(&apos;month&apos;,5,[Close Date]))' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Actual Closed Date is the opportunity is Closed, else Estimated Close Date </run>
                  <run fontcolor='#333333' fontname='Tableau Regular' italic='true'>(Date used for time-series analysis)</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='date' hidden='true' name='[Close Date]' role='dimension' type='ordinal' />
            <column caption='Is Last N months filter - Closed Date?' datatype='boolean' name='[Closed in Last x Days (copy)_1142225515614175234]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_822751375422500864]&gt;DATEADD(&apos;month&apos;,-[Parameters].[Last x Days (copy)_1142225515621146627],__MyToday) AND [Calculation_822751375422500864] &lt;= __MyToday' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='boolean' hidden='true' name='[Closed]' role='dimension' type='nominal' />
            <column datatype='string' name='[First Name]' role='dimension' type='nominal' />
            <column caption='Is Won Opportunity?' datatype='boolean' name='[Is Open Opportunity? (copy)_17451502251433984]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_711568759572299783]=&quot;Y&quot;' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Is Selected Opportunity Owner Flag?' datatype='boolean' name='[Is Selected Opportunity Stage Flag (copy)_813744216047374336]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[Opportunity Owner Parameter]=[Calculation_711568759570620418]' />
              <desc>
                <formatted-text>
                  <run>→Customer Filter</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Total Sales' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_235739231649065059]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([LinPack_961643984189344200])' />
              <desc>
                <formatted-text>
                  <run>Total Sales: &apos;Total Sales&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='_Total Sales (Expression)' datatype='real' name='[LinPack_961643984189344200]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='FLOAT(IF [Is Open Opportunity? (copy)_17451502251433984] THEN [Amount] END)' />
              <desc>
                <formatted-text>
                  <run>_Total Sales (Expression): &apos;Total Sales&apos; expression (used in other KPI calculations, no aggregation rule)</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Opportunity Type]' role='dimension' type='nominal' />
            <column caption='Sales Value (for selected Opp Owner)' datatype='real' default-format='n&quot;#&quot;#,##0;-&quot;#&quot;#,##0' name='[Rank Pipeline Value (for selected Opp Owner) (copy)_703968976547405827]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='MAX(IF [Is Selected Opportunity Stage Flag (copy)_813744216047374336] THEN {INCLUDE [Calculation_711568759570620418] : [LinPack_235739231649065059]} END)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' hidden='true' name='[Stage]' role='dimension' type='nominal' />
            <column datatype='boolean' hidden='true' name='[Won]' role='dimension' type='nominal' />
            <column caption='__MyToday' datatype='date' name='[__MyToday]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKEDATE(2022,04,18)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column-instance column='[Calculation_711568759570489345]' derivation='None' name='[none:Calculation_711568759570489345:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_711568759570620418]' derivation='None' name='[none:Calculation_711568759570620418:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_711568759572115461]' derivation='None' name='[none:Calculation_711568759572115461:nk]' pivot='key' type='nominal' />
