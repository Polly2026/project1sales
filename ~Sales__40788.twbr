            <column caption='Is Last N months filter - Created Date?' datatype='boolean' name='[Last N months filter - Closed Date (copy)_1142225515621388292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Created Date]&gt;DATEADD(&apos;month&apos;,-[Parameters].[Last x Days (copy)_1142225515621146627],__MyToday) AND [Created Date] &lt;= __MyToday' />
