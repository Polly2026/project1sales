              <calculation class='tableau' formula='// Count the distinct number of Opportunity Owner&#13;&#10;// where Opportunity Owner&apos;s [Conversion Rate] &gt; Selected Opportunity Owner [Conversion Rate]&#13;&#10;COUNTD(if {INCLUDE [Calculation_711568759570620418] : [LinPack_713531991123124037]} &gt; {MAX((IF [Is Selected Opportunity Stage Flag (copy)_813744216047374336] THEN {INCLUDE [Calculation_711568759570620418] : ZN([LinPack_713531991123124037])} ELSE 0 END))}&#13;&#10;       and Not [Is Selected Opportunity Stage Flag (copy)_813744216047374336]&#13;&#10;       then [Calculation_711568759570620418]  end)+1' />
