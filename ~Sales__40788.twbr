            <column caption='Opportunity Owner Class (sort)' datatype='integer' name='[Opportunity Owner Class - Title (copy)_1634525252606316547]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [Opportunity Owner Class Deal Size (copy)_995858528092102683]=[Parameters].[pOpportunityOwner_BigDeals (copy)_995858528093823004] THEN 1&#13;&#10;ELSEIF [Opportunity Owner Class Deal Size (copy)_995858528092102683]=[Parameters].[pOpportunityOwner_Champions (copy)_995858528093941789] THEN 2&#13;&#10;ELSEIF [Opportunity Owner Class Deal Size (copy)_995858528092102683]=[Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094035998] THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
