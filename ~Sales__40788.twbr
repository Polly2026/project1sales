                  <run>→Customer Filter</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Is Last N months filter - Created Date?' datatype='boolean' name='[Last N months filter - Closed Date (copy)_1142225515621388292]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Created Date]&gt;DATEADD(&apos;month&apos;,-[Parameters].[Last x Days (copy)_1142225515621146627],__MyToday) AND [Created Date] &lt;= __MyToday' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Pipeline Generated' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_017255839264062096]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([LinPack_523892480737294295])' />
              <desc>
                <formatted-text>
                  <run>Pipeline Generated: &apos;Pipeline Generated&apos; value (numeric format)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Sales Cycle' datatype='real' default-format='n#,##0&quot; d&quot;;(#,##0&quot; d&quot;)' name='[LinPack_451823525181570600]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(FLOAT(IF NOT [Calculation_1142225515624624133] THEN datediff(&quot;minute&quot;, [Created Date], [Calculation_822751375422500864]) / (24*60) END))' />
              <desc>
                <formatted-text>
