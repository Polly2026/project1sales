            <column caption='Avg Deal Size (won)' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_416672484957473515]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([LinPack_760893960995960019])' />
