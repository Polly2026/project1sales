            </column>
            <column caption='Pipeline Review - DONE - Key' datatype='string' name='[Calculation_928304533153746946]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//Achievements&#13;&#10;if      [Calculation_746190227234947072]  then &quot;Last &quot; + [Parameters].[pLastxDays] + &quot; days|Closed Last &quot;+ [Parameters].[pLastxDays] + &quot; days&quot;&#13;&#10;ELSEIF  [Closed in Last 7 Days (copy)_746190227235745795] then &quot;Last &quot; + [Parameters].[pLastxDays] + &quot; days|New Opportunities last &quot;+ [Parameters].[pLastxDays] + &quot; days&quot;&#13;&#10;else &quot;Other&quot;&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
