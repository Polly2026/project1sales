      </column>
      <column caption='Pipeline Profile - Average Deal Size (Star)' datatype='string' name='[Calculation_416864453607927808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(SPACE([Pipeline Profile - Average Deal Size (description) (copy)_995858528069312525]),&quot; &quot;,&quot;★&quot;)&#13;&#10;+&#13;&#10;REPLACE(SPACE(5-[Pipeline Profile - Average Deal Size (description) (copy)_995858528069312525]),&quot; &quot;,&quot;☆&quot;)' />
      </column>
      <column caption='Type' datatype='string' name='[Calculation_436849195593625600]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([Opportunity Type]) THEN &apos;Other&apos; ELSE [Opportunity Type] END' />
