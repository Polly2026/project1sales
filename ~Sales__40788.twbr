                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Stage (according to your standards)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Open Flag' datatype='string' name='[Calculation_711568759572205574]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Closed],&quot;N&quot;,&quot;Y&quot;,&quot;Unknown&quot;)' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Open</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Won Flag' datatype='string' name='[Calculation_711568759572299783]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IIF([Closed] AND [Won],&quot;Y&quot;,&quot;N&quot;,&quot;Unknown&quot; )' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Closed and Won</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Close Date' datatype='date' datatype-customized='true' name='[Calculation_822751375422500864]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Close Date]&#13;&#10;//DATE(DATEADD(&apos;month&apos;,5,[Close Date]))' />
              <desc>
                <formatted-text>
                  <run fontcolor='#333333' fontname='Tableau Regular'>Actual Closed Date is the opportunity is Closed, else Estimated Close Date </run>
                  <run fontcolor='#333333' fontname='Tableau Regular' italic='true'>(Date used for time-series analysis)</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Label FOCUS - Closing Overdue - Nb of Opp' datatype='integer' name='[Calculation_961237109457149952]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Overdue&quot;) then [Calculation_711568759570227200] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='date' hidden='true' name='[Close Date]' role='dimension' type='ordinal' />
