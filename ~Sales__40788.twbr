      <column caption='Sales Cycle (won)' datatype='real' default-format='n#,##0&quot; d&quot;;(#,##0&quot; d&quot;)' name='[LinPack_858688450507045362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(FLOAT(IF [Is Open Opportunity? (copy)_17451502251433984] THEN datediff(&quot;minute&quot;, [Created Date], [Calculation_822751375422500864]) / (24*60) END))' />
        <desc>
