            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Weighted Pipeline Value' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_515310787283302498]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(FLOAT(IF [Calculation_1142225515624624133] THEN [Calculation_711568759573139467]*[Amount] END))' />
