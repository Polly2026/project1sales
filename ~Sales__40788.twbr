              <calculation class='tableau' formula='IF      [_Per Customer: Pipeline Generation (copy)_995858528061906945] &lt;= {fixed: max([_Per Customer: Pipeline Generation (copy)_995858528061906945])}/5 then &quot;1&quot; &#13;&#10;ELSEIF  [_Per Customer: Pipeline Generation (copy)_995858528061906945] &lt;= {fixed: max([_Per Customer: Pipeline Generation (copy)_995858528061906945])}/5*2 then &quot;2&quot; &#13;&#10;ELSEIF  [_Per Customer: Pipeline Generation (copy)_995858528061906945] &lt;= {fixed: max([_Per Customer: Pipeline Generation (copy)_995858528061906945])}/5*3 then &quot;3&quot; &#13;&#10;ELSEIF  [_Per Customer: Pipeline Generation (copy)_995858528061906945] &lt;= {fixed: max([_Per Customer: Pipeline Generation (copy)_995858528061906945])}/5*4 then &quot;4&quot; &#13;&#10;ELSE &quot;5&quot;                                    &#13;&#10;END' />
