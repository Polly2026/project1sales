            </column>
            <column caption='Opportunity Owner Class' datatype='string' name='[Opportunity Owner Class Deal Size (copy)_995858528092102683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &gt;3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &gt;3 THEN [Parameters].[pOpportunityOwner_BigDeals (copy)_995858528093823004]&#13;&#10;ELSEIF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &gt;3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &lt;=3 THEN [Parameters].[pOpportunityOwner_Champions (copy)_995858528093941789]&#13;&#10;ELSEIF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &lt;=3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &gt;3 THEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094035998]&#13;&#10;ELSE [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094134303]&#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Owner Class - Action' datatype='string' name='[Opportunity Owner Class Performance (copy)_995858528097042473]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Opportunity Owner Class Deal Size (copy)_995858528092102683]&#13;&#10;WHEN [Parameters].[pOpportunityOwner_BigDeals (copy)_995858528093823004]                      THEN &quot;Reward these elements, they can be a model for the other owners. Leverage their best-practices.&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_Champions (copy)_995858528093941789]   THEN &quot;Guide them on how to generate pipeline.&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094035998]              THEN &quot;Provide these elements additional trainings to improve their ability to convince clients.&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094134303]           THEN &quot;These opportunity owners need to improve their skills in both areas, to get more business and to win over clients. Train them quickly.&quot; &#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column caption='Opportunity Owner Class - Description' datatype='string' name='[Opportunity Owner Class Performance - Action (copy)_995858528097091626]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Opportunity Owner Class Deal Size (copy)_995858528092102683]&#13;&#10;WHEN [Parameters].[pOpportunityOwner_BigDeals (copy)_995858528093823004]                      THEN &quot;Top performers in the team. They perform well in all areas and pull the team up.&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_Champions (copy)_995858528093941789]   THEN &quot;Effective at closing and winning deals, they can develop in Pipeline Generation (farming or hunting).&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094035998]              THEN &quot;Good at developing pipeline, they will improve their performance by developing their ability to close and win the deals.&quot;&#13;&#10;WHEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094134303]           THEN &quot;Underperforming in pipeline generation and deal closing.&#13;&#10;&quot;   &#13;&#10;END' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
