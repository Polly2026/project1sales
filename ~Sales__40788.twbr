                </formatted-text>
              </desc>
            </column>
            <column caption='Total Closed Opportunities Amount' datatype='real' default-format='c&quot;$ &quot;#,##0;(&quot;$ &quot;#,##0)' name='[LinPack_707557147340278467]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([LinPack_808645294632541416])' />
              <desc>
