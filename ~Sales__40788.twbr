              <calculation class='tableau' formula='[Calculation_680325065948213248]&lt;0 and [Calculation_711568759572205574]=&quot;Y&quot;' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
