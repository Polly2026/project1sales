      </column>
      <column caption='Open Flag' datatype='string' name='[Calculation_711568759572205574]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Closed],&quot;N&quot;,&quot;Y&quot;,&quot;Unknown&quot;)' />
        <desc>
          <formatted-text>
            <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Open</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Won Flag' datatype='string' name='[Calculation_711568759572299783]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Closed] AND [Won],&quot;Y&quot;,&quot;N&quot;,&quot;Unknown&quot; )' />
        <desc>
          <formatted-text>
            <run fontcolor='#333333' fontname='Tableau Regular'>&quot;Y&quot; if the opportunity is Closed and Won</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Probability %' datatype='real' default-format='p0%' name='[Calculation_711568759573139467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Probability (%)]/100' />
        <desc>
          <formatted-text>
            <run fontcolor='#333333' fontname='Tableau Regular'>Probability to win the opportunity (0.5 stands for 50%)</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Opportunity Created Date' datatype='date' datatype-customized='true' name='[Calculation_711568759579521036]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Created Date])' />
        <desc>
          <formatted-text>
            <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Creation Date</run>
          </formatted-text>
