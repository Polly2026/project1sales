            <column datatype='date' hidden='true' name='[Close Date]' role='dimension' type='ordinal' />
            <column caption='Is Created in Last x Days?' datatype='boolean' name='[Closed in Last 7 Days (copy)_746190227235745795]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Days to Close (copy)_928304533158825988]&gt;=0 and [Days to Close (copy)_928304533158825988]&lt;=int([Parameters].[pLastxDays]) and [Calculation_711568759572205574]=&quot;Y&quot;' />
