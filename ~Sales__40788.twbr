            <column caption='Pipeline Review - FOCUS - Key' datatype='string' name='[Pipeline Review - DONE - Key (copy)_746190227239038986]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF      [Closed in Last x Days (copy)_746190227237216263]        then &quot;Overdue|Closing Overdue&quot;&#13;&#10;ELSEIF  [Closed in Last x Days (copy)_746190227237490696] then &quot;Next &quot; + [Parameters].[pNextxDays] + &quot; days|Closing Next &quot;+ [Parameters].[pNextxDays] + &quot; days&quot;&#13;&#10;else &quot;Other&quot;&#13;&#10;end' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' hidden='true' name='[Stage]' role='dimension' type='nominal' />
