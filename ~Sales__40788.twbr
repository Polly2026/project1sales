              <calculation class='tableau' formula='COUNTD(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Next&quot;) then [Calculation_711568759570227200] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
