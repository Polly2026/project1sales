            <column caption='Label FOCUS - Closing Overdue - Opp Amount' datatype='real' name='[Label FOCUS - Closing Overdure - Nb of Opp (copy)_961237109461037063]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Overdue&quot;) then [LinPack_523892480737294295] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
            </column>
            <column datatype='string' name='[Last Name]' role='dimension' type='nominal' />
            <column caption='Nb of Won Opportunities' datatype='integer' default-format='n#,##0;(#,##0)' name='[LinPack_345685562057570044]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(IF [Is Open Opportunity? (copy)_17451502251433984] THEN [Calculation_711568759570227200] END)' />
              <desc>
