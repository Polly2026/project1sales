        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Client/Prospect by Opportunity' datatype='string' name='[Calculation_614178463385964547]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_822751375422500864]&gt;[Calculation_614178463385309184] then &quot;Existing Clients&quot; else &quot;Prospects&quot; end' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Label DONE - Closed WON - Nb of Clients (Existing)' datatype='integer' name='[Calculation_614178463392563210]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Label DONE - Closed WON - Nb of Opp (copy)_614178463390113796] - [Label DONE - Closed WON - Nb of Clients (copy)_614178463392415753]' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Client/Prospect by Account' datatype='string' name='[Calculation_614178463393964044]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if {fixed [Calculation_711568759570489345]: [LinPack_345685562057570044]}&gt;=1 then &quot;Existing Clients&quot; else &quot;Prospects&quot; end' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Days to Close' datatype='integer' default-format='n#,##0&quot; d&quot;;-#,##0&quot; d&quot;' name='[Calculation_680325065948213248]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&quot;day&quot;, [__MyToday], [Calculation_822751375422500864])' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Days to Close (bucket)' datatype='string' name='[Calculation_680325065948696577]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_680325065948213248]&lt;0 then &quot;Overdue&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;30 then &quot;0-30 days&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;90 then &quot;1-3 months&quot;&#13;&#10;ELSEIF [Calculation_680325065948213248]&lt;180 then &quot;3-6 months&quot;&#13;&#10;ELSE &quot;&gt; 6 months&quot;&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Probability (bucket)' datatype='string' name='[Calculation_680325065953697795]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [LinPack_574638457904073940]&lt;0.25 THEN &quot;0-25%&quot;&#13;&#10;ELSEIF [LinPack_574638457904073940]&lt;0.50 THEN &quot;25-50%&quot;&#13;&#10;ELSEIF [LinPack_574638457904073940]&lt;0.75 THEN &quot;50-75%&quot;&#13;&#10;ELSE &quot;75-100%&quot;&#13;&#10;END' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Rank Sales Value (for selected Opp Owner)' datatype='integer' default-format='n&quot;#&quot;#,##0;-&quot;#&quot;#,##0' name='[Calculation_703968976541376514]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Count the distinct number of Opportunity Owner&#13;&#10;// where Opportunity Owner&apos;s [Sales Value] &gt; Selected Opportunity Owner [Sales Value]&#13;&#10;COUNTD(if {INCLUDE [Calculation_711568759570620418] : [LinPack_235739231649065059]} &gt; {MAX((IF [Is Selected Opportunity Stage Flag (copy)_813744216047374336] THEN {INCLUDE [Calculation_711568759570620418] : ZN([LinPack_235739231649065059])} ELSE 0 END))}&#13;&#10;       and Not [Is Selected Opportunity Stage Flag (copy)_813744216047374336]&#13;&#10;       then [Calculation_711568759570620418]  end)+1' />
        <desc>
          <formatted-text>
            <run>→</run>
          </formatted-text>
        </desc>
      </column>
      <column caption='Opportunity Id' datatype='string' name='[Calculation_711568759570227200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Opportunity ID]' />
        <desc>
          <formatted-text>
            <run fontcolor='#333333' fontname='Tableau Regular'>Opportunity Unique Identifier</run>
          </formatted-text>
