            <column caption='Opportunity Owner Class' datatype='string' name='[Opportunity Owner Class Deal Size (copy)_995858528092102683]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &gt;3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &gt;3 THEN [Parameters].[pOpportunityOwner_BigDeals (copy)_995858528093823004]&#13;&#10;ELSEIF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &gt;3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &lt;=3 THEN [Parameters].[pOpportunityOwner_Champions (copy)_995858528093941789]&#13;&#10;ELSEIF [Pipeline Profile - Conversion Rate (description) (copy)_995858528072065042] &lt;=3 AND [Pipeline Profile - Pipeline Generation (description) (copy)_995858528072167443] &gt;3 THEN [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094035998]&#13;&#10;ELSE [Parameters].[pOpportunityOwner_ImprovePipelineGen (copy)_995858528094134303]&#13;&#10;END' />
