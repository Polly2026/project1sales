            <column caption='Label FOCUS - Closing Next x days - Opp Amount' datatype='real' name='[Label FOCUS - Closing Overdue - Opp Amount (copy)_961237109461278729]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(if STARTSWITH([Pipeline Review - DONE - Cat 2 (copy)_746190227239038988], &quot;Closing Next&quot;) then [LinPack_523892480737294295] end)' />
              <desc>
                <formatted-text>
                  <run>→</run>
                </formatted-text>
              </desc>
